# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
DATABASE_MIGRATION_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
